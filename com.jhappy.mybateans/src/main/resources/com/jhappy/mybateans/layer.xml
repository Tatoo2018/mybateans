<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN" "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Editors">
        <file name="com-jhappy-mybateans-indexing-MyBatisIndexerFactory.instance">
            <!--com.jhappy.mybateans.indexing.MyBatisIndexerFactory-->
            <attr name="instanceOf" stringvalue="com.jhappy.mybateans.indexing.MyBatisIndexerFactory"/>
        </file>
        <folder name="text/x-java">
            <folder name="OutputConvertors">
                <file name="MyBatisLogFilter.instance">
                    <attr name="instanceClass" stringvalue="com.jhappy.mybateans.log.MyBatisLogFilter"/>
                    <attr name="instanceOf" stringvalue="org.netbeans.api.extexecution.print.LineConvertor"/>
                </file>
            </folder>
        </folder>
    </folder>
    
    <folder name="Templates">
        <folder name="MyBatis">
            <file name="MyBatisMapperTemplate.xml" url="nbres:/com/jhappy/mybateans/template/file/MyBatisMapperTemplate.xml">
                <attr name="displayName" stringvalue="bundlecol:com.jhappy.mybateans.template.Bundle#LBL_XmlTemplate"/>
                <attr name="template" boolvalue="true"/>
            </file>
            <file name="MyBatisMapperJavaTemplate.ftl" url="nbres:/com/jhappy/mybateans/template/file/MyBatisMapperJavaTemplate.ftl">
                <attr name="displayName" stringvalue="bundlecol:com.jhappy.mybateans.template.Bundle#LBL_JavaTemplate"/>
                <attr name="template" boolvalue="true"/>
            </file>
        </folder>
    </folder>
    
    

</filesystem>
